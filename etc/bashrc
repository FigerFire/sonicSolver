# Source this file from ~/.bashrc (or ~/.zshrc) to load SonicSolver.
# Resolve the checkout from this file so it can be sourced from any directory.
if [ -n "${BASH_VERSION:-}" ]; then
    SONIC_PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
elif [ -n "${ZSH_VERSION:-}" ]; then
    SONIC_PROJECT_DIR="$(cd "$(dirname "${(%):-%N}")/.." && pwd)"
else
    echo 'SonicSolver environment requires Bash or Zsh.' >&2
    return 1
fi
export SONIC_PROJECT_DIR
case ":${PATH}:" in
    *":${SONIC_PROJECT_DIR}/build:"*) ;;
    *) export PATH="${SONIC_PROJECT_DIR}/build:${PATH}" ;;
esac

# Completion belongs to interactive shells; batch jobs only need PATH.
case "$-" in
    *i*)
        if [ -n "${BASH_VERSION:-}" ]; then
            source "${SONIC_PROJECT_DIR}/scripts/sonicSolver-completion.bash"
        else
            case ":${(j.:.)fpath}:" in
                *":${SONIC_PROJECT_DIR}/scripts:"*) ;;
                *) fpath=("${SONIC_PROJECT_DIR}/scripts" "${fpath[@]}") ;;
            esac
            if ! typeset -f compdef >/dev/null; then
                autoload -Uz compinit && compinit
            fi
            autoload -Uz _sonicSolver
            compdef _sonicSolver sonicSolver
        fi
        ;;
esac
